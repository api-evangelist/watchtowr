{
  "opencollection": "1.0.0",
  "info": {
    "name": "watchTowr Platform Client Activity Log Domains API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all domain assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.watchtowr.io/api/client/assets/domain/list",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Pagination page. The default value is 1."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Pagination size. The default value is 10 and the maximum is 30."
              }
            ]
          },
          "docs": "List all domain assets"
        },
        {
          "info": {
            "name": "Show the details of a domain asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.watchtowr.io/api/client/assets/domain/show/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the id."
              }
            ]
          },
          "docs": "Show the details of a domain asset"
        },
        {
          "info": {
            "name": "Update the status of a domain asset",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenant}.{region}.watchtowr.io/api/client/assets/domain/update-status/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the id."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the status of a domain asset"
        }
      ]
    }
  ],
  "bundled": true
}